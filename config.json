  "memoryRoot": "~/.dsh/whale-soul/memory",
  "vectorDir": "vector",
  "ollama": {
    "baseUrl": "http://127.0.0.1:11434",
    "embeddingModel": "nomic-embed-text",
    "embedDimension": 768,
    "taskModel": "qwen2.5:7b",
    "timeoutMs": 30000
